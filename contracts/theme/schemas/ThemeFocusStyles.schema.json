{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tcc.local/theme/ThemeFocusStyles.schema.json",
  "title": "ThemeFocusStyles",
  "type": "object",
  "required": [
    "schema_version",
    "minimum_contrast_ratio",
    "visible_on_all_interactive_controls",
    "programmatic_order_preserved",
    "modal_focus_trap_preserved",
    "focus_restoration_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "minimum_contrast_ratio": {
      "type": "number",
      "minimum": 3.0
    },
    "visible_on_all_interactive_controls": {
      "const": true
    },
    "programmatic_order_preserved": {
      "const": true
    },
    "modal_focus_trap_preserved": {
      "const": true
    },
    "focus_restoration_required": {
      "const": true
    }
  },
  "additionalProperties": false
}
