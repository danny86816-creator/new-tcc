{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tcc.local/theme/ThemeLayoutAdapter.schema.json",
  "title": "ThemeLayoutAdapter",
  "type": "object",
  "required": [
    "schema_version",
    "surface_id",
    "zones",
    "keyboard_and_focus"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "surface_id": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "UX-HOME-001",
        "UX-HOME-002",
        "UX-ONB-001",
        "UX-ONB-002",
        "UX-ONB-003",
        "UX-RISK-001",
        "UX-RISK-002",
        "UX-RISK-003",
        "UX-RISK-004",
        "UX-RISK-005",
        "UX-PLAN-001",
        "UX-PLAN-002",
        "UX-PLAN-003",
        "UX-PLAN-004",
        "UX-PLAN-005",
        "UX-POS-001",
        "UX-POS-002",
        "UX-POS-003",
        "UX-CLOSE-001",
        "UX-CLOSE-002",
        "UX-CLOSE-003",
        "UX-ORDER-001",
        "UX-CLOSE-004",
        "UX-REVIEW-001",
        "UX-REVIEW-002",
        "UX-REVIEW-003",
        "UX-REVIEW-004",
        "UX-REVIEW-005",
        "UX-REVIEW-006",
        "UX-MILE-001",
        "UX-CAL-001",
        "UX-CAL-002",
        "UX-CAL-003",
        "UX-ANALYTICS-001",
        "UX-ANALYTICS-002",
        "UX-TEAM-001",
        "UX-TEAM-002",
        "UX-TEAM-003",
        "UX-TEAM-004",
        "UX-ROOM-001",
        "UX-ROOM-002",
        "UX-COLLAB-001",
        "UX-AI-001",
        "UX-AI-002",
        "UX-AI-003",
        "UX-AI-004",
        "UX-DATA-001",
        "UX-ARCH-001",
        "UX-DATA-002",
        "UX-REC-001",
        "UX-MIG-001",
        "UX-MIG-002",
        "UX-THEME-001",
        "UX-THEME-002",
        "UX-THEME-003",
        "UX-SET-001",
        "UX-SET-002",
        "UX-SET-003",
        "UX-SET-004",
        "UX-SET-005",
        "UX-SET-006",
        "UX-AUTH-001",
        "UX-AUTH-002",
        "UX-AUTH-003",
        "UX-EXT-001",
        "UX-EXT-002",
        "UX-CONN-001",
        "UX-NOTIF-001",
        "UX-CMD-001",
        "UX-FLOAT-001",
        "UX-SAFE-001"
      ]
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "zone_id",
          "placement",
          "visibility",
          "rearrangeability",
          "collapse_allowed"
        ],
        "properties": {
          "zone_id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "ZONE-SAFETY-CORE",
              "ZONE-CONTEXT-HEADER",
              "ZONE-STATUS-STRIP",
              "ZONE-PRIMARY-ACTION",
              "ZONE-EVIDENCE",
              "ZONE-RISK",
              "ZONE-DECISION",
              "ZONE-TIMELINE",
              "ZONE-CHECKLIST",
              "ZONE-APPROVAL",
              "ZONE-COLLABORATION",
              "ZONE-ATTACHMENTS",
              "ZONE-AUDIT-HISTORY",
              "ZONE-SECONDARY-UTILITY",
              "ZONE-RECOVERY",
              "ZONE-PRIVACY",
              "ZONE-CONFIRMATION"
            ]
          },
          "placement": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "type": "string",
            "minLength": 1
          },
          "rearrangeability": {
            "type": "string",
            "minLength": 1
          },
          "collapse_allowed": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "keyboard_and_focus": {
      "type": "object",
      "required": [
        "focus_order_policy",
        "keyboard_activation_policy",
        "modal_focus_trap_preserved",
        "focus_restoration_target",
        "shortcut_conflict_policy",
        "custom_composite_keyboard_pattern",
        "hidden_element_focus_policy",
        "preview_keyboard_exit_required",
        "escape_cancel_behavior"
      ],
      "properties": {
        "focus_order_policy": {
          "type": "string",
          "minLength": 1
        },
        "keyboard_activation_policy": {
          "type": "string",
          "minLength": 1
        },
        "modal_focus_trap_preserved": {
          "const": true
        },
        "focus_restoration_target": {
          "type": "string",
          "minLength": 1
        },
        "shortcut_conflict_policy": {
          "type": "string",
          "minLength": 1
        },
        "custom_composite_keyboard_pattern": {
          "type": "string",
          "minLength": 1
        },
        "hidden_element_focus_policy": {
          "type": "string",
          "minLength": 1
        },
        "preview_keyboard_exit_required": {
          "const": true
        },
        "escape_cancel_behavior": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
