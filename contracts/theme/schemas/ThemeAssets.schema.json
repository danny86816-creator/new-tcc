{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tcc.local/theme/ThemeAssets.schema.json",
  "title": "ThemeAssets",
  "type": "object",
  "required": [
    "schema_version",
    "theme_id",
    "version",
    "assets",
    "asset_budgets"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "theme_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "path",
          "type",
          "tier",
          "variant_scope",
          "surface_scope",
          "required",
          "fallback_asset_id",
          "sha256",
          "size_bytes",
          "dpi_policy",
          "load_policy",
          "dispose_policy"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\.[/\\\\]).+$"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "image",
              "font",
              "audio",
              "vector",
              "animation",
              "data"
            ]
          },
          "tier": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "tier0",
              "tier1",
              "tier2",
              "tier3",
              "audio"
            ]
          },
          "variant_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "surface_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "UX-HOME-001",
                "UX-HOME-002",
                "UX-ONB-001",
                "UX-ONB-002",
                "UX-ONB-003",
                "UX-RISK-001",
                "UX-RISK-002",
                "UX-RISK-003",
                "UX-RISK-004",
                "UX-RISK-005",
                "UX-PLAN-001",
                "UX-PLAN-002",
                "UX-PLAN-003",
                "UX-PLAN-004",
                "UX-PLAN-005",
                "UX-POS-001",
                "UX-POS-002",
                "UX-POS-003",
                "UX-CLOSE-001",
                "UX-CLOSE-002",
                "UX-CLOSE-003",
                "UX-ORDER-001",
                "UX-CLOSE-004",
                "UX-REVIEW-001",
                "UX-REVIEW-002",
                "UX-REVIEW-003",
                "UX-REVIEW-004",
                "UX-REVIEW-005",
                "UX-REVIEW-006",
                "UX-MILE-001",
                "UX-CAL-001",
                "UX-CAL-002",
                "UX-CAL-003",
                "UX-ANALYTICS-001",
                "UX-ANALYTICS-002",
                "UX-TEAM-001",
                "UX-TEAM-002",
                "UX-TEAM-003",
                "UX-TEAM-004",
                "UX-ROOM-001",
                "UX-ROOM-002",
                "UX-COLLAB-001",
                "UX-AI-001",
                "UX-AI-002",
                "UX-AI-003",
                "UX-AI-004",
                "UX-DATA-001",
                "UX-ARCH-001",
                "UX-DATA-002",
                "UX-REC-001",
                "UX-MIG-001",
                "UX-MIG-002",
                "UX-THEME-001",
                "UX-THEME-002",
                "UX-THEME-003",
                "UX-SET-001",
                "UX-SET-002",
                "UX-SET-003",
                "UX-SET-004",
                "UX-SET-005",
                "UX-SET-006",
                "UX-AUTH-001",
                "UX-AUTH-002",
                "UX-AUTH-003",
                "UX-EXT-001",
                "UX-EXT-002",
                "UX-CONN-001",
                "UX-NOTIF-001",
                "UX-CMD-001",
                "UX-FLOAT-001",
                "UX-SAFE-001"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "required": {
            "type": "boolean"
          },
          "fallback_asset_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "dimensions": {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "dpi_policy": {
            "type": "string",
            "minLength": 1
          },
          "load_policy": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "startup",
              "immediate",
              "lazy",
              "opportunistic",
              "preview_only"
            ]
          },
          "dispose_policy": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "asset_budgets": {
      "type": "object",
      "required": [
        "max_total_package_bytes",
        "max_extracted_package_bytes",
        "max_tier0_bytes",
        "max_tier0_decoded_memory_bytes",
        "max_tier1_bytes",
        "max_tier2_bytes",
        "max_tier3_bytes",
        "max_audio_total_bytes",
        "max_bgm_total_bytes",
        "max_preview_assets_bytes",
        "max_single_asset_bytes",
        "max_single_asset_width_px",
        "max_single_asset_height_px",
        "max_single_asset_decoded_memory_bytes",
        "max_gpu_texture_memory_bytes",
        "max_cache_bytes_per_theme",
        "max_cache_bytes_global"
      ],
      "properties": {
        "max_total_package_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_extracted_package_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_tier0_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_tier0_decoded_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_tier1_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_tier2_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_tier3_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_audio_total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_bgm_total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_preview_assets_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_single_asset_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_single_asset_width_px": {
          "type": "integer",
          "minimum": 0
        },
        "max_single_asset_height_px": {
          "type": "integer",
          "minimum": 0
        },
        "max_single_asset_decoded_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_gpu_texture_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_cache_bytes_per_theme": {
          "type": "integer",
          "minimum": 0
        },
        "max_cache_bytes_global": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
