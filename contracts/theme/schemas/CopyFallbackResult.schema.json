{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tcc.local/theme/CopyFallbackResult.schema.json",
  "title": "CopyFallbackResult",
  "type": "object",
  "required": [
    "schema_version",
    "key",
    "locale",
    "value",
    "source",
    "is_critical",
    "used_core_fallback",
    "is_valid"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "theme_noncritical",
        "theme_approved_critical",
        "core_fallback"
      ]
    },
    "is_critical": {
      "type": "boolean"
    },
    "used_core_fallback": {
      "type": "boolean"
    },
    "is_valid": {
      "const": true
    }
  },
  "additionalProperties": false
}
