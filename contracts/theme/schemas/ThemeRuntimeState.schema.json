{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tcc.local/theme/ThemeRuntimeState.schema.json",
  "title": "ThemeRuntimeState",
  "type": "object",
  "required": [
    "schema_version",
    "state_id",
    "user_id",
    "device_id",
    "theme_id",
    "theme_version",
    "variant_id",
    "personalization",
    "audio",
    "motion",
    "automation",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "theme_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "theme_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "variant_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_state": {
      "type": "object",
      "required": [
        "workspace_id",
        "layout_ref",
        "monitor_binding",
        "window_bounds"
      ],
      "properties": {
        "workspace_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "enum": [
                "WS-PERSONAL",
                "WS-TEAM",
                "WS-DAILY",
                "WS-PREMARKET",
                "WS-TRADING",
                "WS-REVIEW",
                "WS-COLLAB",
                "WS-FLOAT"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^WS-CUSTOM-[A-Z0-9][A-Z0-9-]*$"
            }
          ]
        },
        "layout_ref": {
          "type": "string",
          "minLength": 1
        },
        "monitor_binding": {
          "type": "string",
          "minLength": 1
        },
        "window_bounds": {
          "type": "object",
          "required": [
            "x",
            "y",
            "width",
            "height",
            "dpi_scale"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "minimum": 1.0
            },
            "height": {
              "type": "number",
              "minimum": 1.0
            },
            "dpi_scale": {
              "type": "number",
              "minimum": 1.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "personalization": {
      "type": "object",
      "required": [
        "preset_id",
        "values"
      ],
      "properties": {
        "preset_id": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "required": [
        "master_theme_audio_enabled",
        "master_theme_audio_volume",
        "bgm_enabled",
        "bgm_volume",
        "ambient_enabled",
        "ambient_volume",
        "ui_sound_enabled",
        "ui_sound_volume",
        "alert_supplement_enabled",
        "alert_supplement_volume",
        "night_mode",
        "ducking_enabled"
      ],
      "properties": {
        "master_theme_audio_enabled": {
          "type": "boolean"
        },
        "master_theme_audio_volume": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "bgm_enabled": {
          "type": "boolean"
        },
        "bgm_volume": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "ambient_enabled": {
          "type": "boolean"
        },
        "ambient_volume": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "ui_sound_enabled": {
          "type": "boolean"
        },
        "ui_sound_volume": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "alert_supplement_enabled": {
          "type": "boolean"
        },
        "alert_supplement_volume": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "night_mode": {
          "type": "boolean"
        },
        "ducking_enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "required": [
        "intensity",
        "parallax_enabled"
      ],
      "properties": {
        "intensity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "parallax_enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "required": [
        "time_of_day_scene_enabled",
        "trading_state_overlay_enabled",
        "automation_pinned_or_disabled"
      ],
      "properties": {
        "time_of_day_scene_enabled": {
          "type": "boolean"
        },
        "trading_state_overlay_enabled": {
          "type": "boolean"
        },
        "automation_pinned_or_disabled": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "default",
            "pinned",
            "disabled"
          ]
        }
      },
      "additionalProperties": false
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
