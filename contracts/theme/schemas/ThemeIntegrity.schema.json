{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tcc.local/theme/ThemeIntegrity.schema.json",
  "title": "ThemeIntegrity",
  "type": "object",
  "required": [
    "schema_version",
    "theme_id",
    "version",
    "hash_algorithm",
    "files",
    "package_hash",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "theme_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "required"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:|/|\\\\|.*\\.\\.[/\\\\]).+$"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "package_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
