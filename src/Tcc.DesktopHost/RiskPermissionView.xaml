<UserControl x:Class="Tcc.DesktopHost.RiskPermissionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="1568" MinHeight="889"
             Background="{DynamicResource Tcc.Strata.Brush.Background}"
             Foreground="{DynamicResource Tcc.Strata.Brush.Text}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="Risk.Surface.Primary" TargetType="Border" BasedOn="{StaticResource Strata.Panel.Primary}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tcc.Strata.Brush.Border}" />
        </Style>
        <Style x:Key="Risk.Surface.Secondary" TargetType="Border" BasedOn="{StaticResource Strata.Panel.Secondary}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
        </Style>
        <Style x:Key="Risk.Band.Current" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Tcc.Strata.Brush.Panel.Safety}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tcc.Strata.Brush.Danger}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="Risk.Surface.Timeline" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Tcc.Strata.Brush.PanelDeep}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tcc.Strata.Brush.BorderBright}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="Risk.ViewportFocusVisual" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Border Margin="2" BorderBrush="{DynamicResource Tcc.Strata.Brush.Ice}" BorderThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Tcc.Strata.Brush.Background}">
        <Image Source="Assets/Risk/Tcc.RiskPermission.GuardedPass.Background.R1.png"
               Stretch="UniformToFill"
               Opacity="{DynamicResource Tcc.Strata.SceneOpacity}"
               RenderOptions.BitmapScalingMode="HighQuality"
               IsHitTestVisible="False"
               Focusable="False" />
        <Rectangle Fill="{DynamicResource Tcc.Strata.Brush.SceneVeil}" IsHitTestVisible="False" />
        <ScrollViewer x:Name="RiskPermissionScroller"
                      AutomationProperties.AutomationId="RiskPermissionScroller"
                      AutomationProperties.Name="交易權限總覽唯讀展示"
                      AutomationProperties.HelpText="唯讀交易權限總覽。文字放大或視窗較小時，請在此面板按 PageDown，並以方向鍵檢視完整內容。"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      PanningMode="Both"
                      Focusable="True"
                      IsTabStop="True"
                      FocusVisualStyle="{StaticResource Risk.ViewportFocusVisual}">
            <Grid MinWidth="1476" MinHeight="817" Margin="34,24,38,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="風險 / 交易權限" Style="{StaticResource Strata.HeaderEyebrow}"
                                   AutomationProperties.AutomationId="Risk.Header"
                                   AutomationProperties.Name="風險，交易權限總覽，唯讀展示" />
                        <TextBlock Margin="0,4,0,0" Text="交易權限總覽" Style="{StaticResource Strata.PageTitle}" />
                        <TextBlock Margin="0,7,0,0" Text="UX-RISK-001 · MOD-RISK-PERMISSION" Style="{StaticResource Strata.Caption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="離線 · 唯讀" Style="{StaticResource Strata.StatusValue}"
                                   Foreground="{DynamicResource Tcc.Strata.Brush.Danger}"
                                   HorizontalAlignment="Right"
                                   AutomationProperties.AutomationId="Risk.GlobalState"
                                   AutomationProperties.Name="離線。交易權限尚未評估，不宣稱目前可交易、警告或封鎖。"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Margin="0,4,0,0" Text="來源與新鮮度不可用" Style="{StaticResource Strata.Overline}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,16,0,16" Padding="18,14"
                        Style="{StaticResource Risk.Band.Current}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="3" Height="52" Margin="0,0,16,0" Background="{DynamicResource Tcc.Strata.Brush.Danger}" />
                            <StackPanel>
                                <TextBlock Text="目前交易權限" Style="{StaticResource Strata.Overline}"
                                           AutomationProperties.AutomationId="Risk.CurrentPermission"
                                           AutomationProperties.Name="目前交易權限未評估。這不是可交易、警告或封鎖判定。" />
                                <TextBlock Margin="0,5,0,0" Text="未評估" Style="{StaticResource Strata.StatusValue}" Foreground="{DynamicResource Tcc.Strata.Brush.Danger}" />
                                <TextBlock Margin="0,4,0,0" Text="不是正式風險判定" Style="{StaticResource Strata.Caption}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="帳戶 / 群組" Style="{StaticResource Strata.Overline}" />
                            <TextBlock Margin="0,5,0,0" Text="不可用" Style="{StaticResource Strata.StatusUnknown}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="評估時間" Style="{StaticResource Strata.Overline}" />
                            <TextBlock Margin="0,5,0,0" Text="尚未評估" Style="{StaticResource Strata.StatusUnknown}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="資料來源 / 新鮮度" Style="{StaticResource Strata.Overline}" />
                            <TextBlock Margin="0,5,0,0" Text="離線 / 不可用" Style="{StaticResource Strata.StatusUnknown}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <GroupBox x:Name="RiskStateRegion" Grid.Row="2" Margin="0,0,0,16"
                          BorderThickness="0" Padding="0" Background="Transparent"
                          Focusable="False" IsTabStop="False"
                          AutomationProperties.AutomationId="Risk.StateRegion"
                          AutomationProperties.Name="離線。交易權限證據無法使用，系統不做推測。"
                          AutomationProperties.LiveSetting="Polite">
                    <GroupBox.Template><ControlTemplate TargetType="GroupBox"><ContentPresenter /></ControlTemplate></GroupBox.Template>
                    <Grid MinHeight="78">
                        <Border x:Name="EmptyState" Visibility="Collapsed" Padding="16,12" Style="{StaticResource Risk.Surface.Secondary}">
                            <StackPanel><TextBlock Text="空白 · 尚無權限評估" Style="{StaticResource Strata.EmptyStateTitle}" /><TextBlock Margin="0,4,0,0" Text="沒有可顯示的帳戶或規則證據；系統不建立替代判定。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border x:Name="LoadingState" Visibility="Collapsed" Padding="16,12" Style="{StaticResource Risk.Surface.Secondary}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="載入中" Style="{StaticResource Strata.StatusValue}" /><ProgressBar Margin="0,8,0,0" Height="5" IsIndeterminate="True" IsHitTestVisible="False" /></StackPanel><TextBlock Grid.Column="1" Margin="18,0,0,0" Text="載入完成前不顯示可交易、警告或封鎖判定。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
                        </Border>
                        <Border x:Name="OfflineState" Padding="16,12" BorderBrush="{DynamicResource Tcc.Strata.Brush.Danger}" BorderThickness="2,0,0,0" Background="{DynamicResource Tcc.Strata.Brush.PanelQuiet}" CornerRadius="2">
                            <StackPanel><TextBlock Text="離線 · 尚未評估" Style="{StaticResource Strata.StatusValue}" Foreground="{DynamicResource Tcc.Strata.Brush.Danger}" /><TextBlock Margin="0,4,0,0" Text="交易權限證據、限制與核准狀態無法使用；系統不做推測，也不提供略過方式。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border x:Name="ErrorState" Visibility="Collapsed" Padding="16,12" BorderBrush="{DynamicResource Tcc.Strata.Brush.Danger}" BorderThickness="2,0,0,0" Background="{DynamicResource Tcc.Strata.Brush.PanelQuiet}" CornerRadius="2">
                            <StackPanel><TextBlock Text="錯誤 · 無法完成評估" Style="{StaticResource Strata.StatusValue}" Foreground="{DynamicResource Tcc.Strata.Brush.Danger}" /><TextBlock Margin="0,4,0,0" Text="資料未被變更；請檢查來源與新鮮度後重新評估。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border x:Name="BlockedState" Visibility="Collapsed" Padding="16,12" BorderBrush="{DynamicResource Tcc.Strata.Brush.Gold}" BorderThickness="2,0,0,0" Background="{DynamicResource Tcc.Strata.Brush.PanelQuiet}" CornerRadius="2">
                            <StackPanel><TextBlock Text="封鎖 · 不可交易" Style="{StaticResource Strata.StatusValue}" Foreground="{DynamicResource Tcc.Strata.Brush.Gold}" /><TextBlock Margin="0,4,0,0" Text="預覽狀態：正式判定必須同時揭露原因、目前值、限制、核准與解除路徑；不得略過。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                    </Grid>
                </GroupBox>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Padding="20,17" Style="{StaticResource Risk.Surface.Primary}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="3" Height="30" Margin="0,0,14,0" Background="{DynamicResource Tcc.Strata.Brush.Gold}" />
                                        <StackPanel>
                                            <TextBlock Text="權限判定圖例" Style="{StaticResource Strata.SectionTitle}"
                                                       AutomationProperties.AutomationId="Risk.Semantics"
                                                       AutomationProperties.Name="固定交易權限語意：可交易、警告、封鎖。語意不得隨主題改變。" />
                                            <TextBlock Margin="0,3,0,0" Text="下列為狀態定義，不是目前帳戶判定 · 三種狀態牌只定義語意" Style="{StaticResource Strata.Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid Margin="0,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{DynamicResource Tcc.Strata.Brush.Ice}" /><StackPanel Grid.Column="1" Margin="14,2,0,2"><TextBlock Text="可交易" Style="{StaticResource Strata.StatusValue}" /><TextBlock Margin="0,4,0,0" Text="TRADABLE" Style="{StaticResource Strata.Overline}" /><TextBlock Margin="0,8,0,0" Text="必要證據有效，且未觸發阻擋規則。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel></Grid>
                                        <Border Grid.Column="1" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                        <Grid Grid.Column="2" Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{DynamicResource Tcc.Strata.Brush.Gold}" /><StackPanel Grid.Column="1" Margin="14,2,0,2"><TextBlock Text="警告" Style="{StaticResource Strata.StatusValue}" /><TextBlock Margin="0,4,0,0" Text="WARNING" Style="{StaticResource Strata.Overline}" /><TextBlock Margin="0,8,0,0" Text="風險明確揭露後，仍須理解影響。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel></Grid>
                                        <Border Grid.Column="3" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                        <Grid Grid.Column="4" Margin="16,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{DynamicResource Tcc.Strata.Brush.Danger}" /><StackPanel Grid.Column="1" Margin="14,2,0,2"><TextBlock Text="封鎖" Style="{StaticResource Strata.StatusValue}" /><TextBlock Margin="0,4,0,0" Text="BLOCKED" Style="{StaticResource Strata.Overline}" /><TextBlock Margin="0,8,0,0" Text="不可交易；原因與解除路徑不得略過。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel></Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" Padding="20,16" Style="{StaticResource Risk.Surface.Secondary}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="判定證據稽核" Style="{StaticResource Strata.SectionTitle}"
                                                   AutomationProperties.AutomationId="Risk.EvidenceMatrix"
                                                   AutomationProperties.Name="判定所需證據。證據與原因尚未載入；目前值與限制未知；核准與稽核不可用；來源與新鮮度離線且不可用。" />
                                        <TextBlock Grid.Column="1" Text="4 項必要輸入 · 0 項可用" Style="{StaticResource Strata.Overline}" Foreground="{DynamicResource Tcc.Strata.Brush.Danger}" />
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="01" Style="{StaticResource Strata.StatusUnknown}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,3,20,3" VerticalAlignment="Center"><TextBlock Text="證據與原因" Style="{StaticResource Strata.Overline}" /><TextBlock Margin="0,5,0,0" Text="尚未載入 · 規則與違規原因不可用" Style="{StaticResource Strata.StatusUnknown}" TextWrapping="Wrap" /></StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                        <StackPanel Grid.Column="3" Margin="20,3,0,3" VerticalAlignment="Center"><TextBlock Text="目前值 / 限制" Style="{StaticResource Strata.Overline}" /><TextBlock Margin="0,5,0,0" Text="— / — · 不得以預設值代替" Style="{StaticResource Strata.StatusUnknown}" TextWrapping="Wrap" /></StackPanel>
                                        <Border Grid.Row="1" Grid.ColumnSpan="4" Background="{DynamicResource Tcc.Strata.Brush.RowSeparator}" />
                                        <TextBlock Grid.Row="2" Text="02" Style="{StaticResource Strata.StatusUnknown}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,3,20,3" VerticalAlignment="Center"><TextBlock Text="核准 / 稽核" Style="{StaticResource Strata.Overline}" /><TextBlock Margin="0,5,0,0" Text="不可用 · 沒有核准或覆寫路徑" Style="{StaticResource Strata.StatusUnknown}" TextWrapping="Wrap" /></StackPanel>
                                        <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                        <StackPanel Grid.Row="2" Grid.Column="3" Margin="20,3,0,3" VerticalAlignment="Center"><TextBlock Text="來源 / 新鮮度" Style="{StaticResource Strata.Overline}" /><TextBlock Margin="0,5,0,0" Text="離線 / 不可用 · 不沿用舊資料" Style="{StaticResource Strata.StatusUnknown}" TextWrapping="Wrap" /></StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Padding="20,18" Style="{StaticResource Risk.Surface.Timeline}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal"><Border Width="3" Height="27" Margin="0,0,14,0" Background="{DynamicResource Tcc.Strata.Brush.Gold}" /><TextBlock Text="解除路徑時間軸" Style="{StaticResource Strata.SectionTitle}"
                                           AutomationProperties.AutomationId="Risk.ResolutionPath"
                                           AutomationProperties.Name="解除或修正路徑目前不可用。本階段不提供操作，也沒有略過方式。" /></StackPanel>
                                <TextBlock Grid.Row="1" Margin="0,5,0,12" Text="目前不可用 · 本階段無法執行" Style="{StaticResource Strata.StatusUnknown}" />
                                <Grid Grid.Row="2" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="1" Margin="14,14,0,14" Background="{DynamicResource Tcc.Strata.Brush.BorderBright}" HorizontalAlignment="Left" />
                                    <StackPanel Grid.ColumnSpan="2">
                                        <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" BorderBrush="{DynamicResource Tcc.Strata.Brush.Ice}" BorderThickness="1" Background="{DynamicResource Tcc.Strata.Brush.PanelDeep}"><TextBlock Text="01" Style="{StaticResource Strata.Overline}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="查明原因與證據" Style="{StaticResource Strata.StatusValue}" /><TextBlock Margin="0,3,0,0" Text="規則、違規與來源必須可驗證" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel></Grid>
                                        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" BorderBrush="{DynamicResource Tcc.Strata.Brush.Ice}" BorderThickness="1" Background="{DynamicResource Tcc.Strata.Brush.PanelDeep}"><TextBlock Text="02" Style="{StaticResource Strata.Overline}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="核對目前值與限制" Style="{StaticResource Strata.StatusValue}" /><TextBlock Margin="0,3,0,0" Text="不得以預設值補足缺漏" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel></Grid>
                                        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" BorderBrush="{DynamicResource Tcc.Strata.Brush.Gold}" BorderThickness="1" Background="{DynamicResource Tcc.Strata.Brush.PanelDeep}"><TextBlock Text="03" Style="{StaticResource Strata.Overline}" Foreground="{DynamicResource Tcc.Strata.Brush.Gold}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="完成核准與解除條件" Style="{StaticResource Strata.StatusValue}" /><TextBlock Margin="0,3,0,0" Text="本唯讀首屏沒有覆寫入口" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel></Grid>
                                        <Grid Margin="0,6,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" BorderBrush="{DynamicResource Tcc.Strata.Brush.Danger}" BorderThickness="1" Background="{DynamicResource Tcc.Strata.Brush.PanelDeep}"><TextBlock Text="04" Style="{StaticResource Strata.Overline}" Foreground="{DynamicResource Tcc.Strata.Brush.Danger}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="重新評估並留下稽核" Style="{StaticResource Strata.StatusValue}" /><TextBlock Margin="0,3,0,0" Text="正式資料完成後才可形成判定" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel></Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Padding="18,14" BorderBrush="{DynamicResource Tcc.Strata.Brush.Gold}" BorderThickness="3,0,0,0" Background="{DynamicResource Tcc.Strata.Brush.PanelQuiet}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="高影響變更確認帶" Style="{StaticResource Strata.SectionTitle}" />
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="舊值" Style="{StaticResource Strata.StatusValue}" /><TextBlock Grid.Column="1" Margin="8,0" Text="→" Style="{StaticResource Strata.Caption}" /><TextBlock Grid.Column="2" Text="新值" Style="{StaticResource Strata.StatusValue}" /><TextBlock Grid.Column="3" Margin="8,0" Text="→" Style="{StaticResource Strata.Caption}" /><TextBlock Grid.Column="4" Text="風險影響" Style="{StaticResource Strata.StatusValue}" /><TextBlock Grid.Column="5" Margin="8,0" Text="→" Style="{StaticResource Strata.Caption}" /><TextBlock Grid.Column="6" Text="明確確認" Style="{StaticResource Strata.StatusValue}" Foreground="{DynamicResource Tcc.Strata.Brush.Gold}" />
                                </Grid>
                                <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="套用前必須模擬與安全驗證；本階段沒有變更、核准或覆寫操作。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="4" Margin="0,16,0,0" Padding="18,13" Style="{StaticResource Risk.Surface.Secondary}"
                        Focusable="False" IsHitTestVisible="False"
                        AutomationProperties.Name="範圍聲明。連接器僅限唯讀同步、對帳與監控；沒有下單或執行路徑；GPT可選且不是正式評分。">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="連接器 · 僅限唯讀同步／對帳／監控 · 沒有下單或執行路徑" Style="{StaticResource Strata.Caption}" />
                        <TextBlock Grid.Column="1" Text="GPT · 可選 · 非正式評分" Style="{StaticResource Strata.Overline}" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
