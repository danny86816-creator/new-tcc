<Window x:Class="Tcc.DesktopHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tcc.DesktopHost"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TCC — Strata Observatory"
        Width="1672" Height="941"
        MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Tcc.Strata.Brush.Background}" Foreground="{DynamicResource Tcc.Strata.Brush.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/StrataObservatory.Design.xaml" />
                <ResourceDictionary Source="Resources/StrataObservatory.Iconography.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Human-approved Mental State Suite R1: one presentation-only 4x2 atlas. -->
            <BitmapImage x:Key="Tcc.Strata.MentalStateAtlas.R1"
                         UriSource="Assets/StrataObservatory/StrataObservatory.MentalStateSuite.R1.png" />
            <CroppedBitmap x:Key="Tcc.Strata.MentalStateGlyph.NotSet"
                           Source="{StaticResource Tcc.Strata.MentalStateAtlas.R1}" SourceRect="0,0,444,444" />
            <CroppedBitmap x:Key="Tcc.Strata.MentalStateGlyph.Calm"
                           Source="{StaticResource Tcc.Strata.MentalStateAtlas.R1}" SourceRect="444,0,443,444" />
            <CroppedBitmap x:Key="Tcc.Strata.MentalStateGlyph.Focused"
                           Source="{StaticResource Tcc.Strata.MentalStateAtlas.R1}" SourceRect="887,0,444,444" />
            <CroppedBitmap x:Key="Tcc.Strata.MentalStateGlyph.Cautious"
                           Source="{StaticResource Tcc.Strata.MentalStateAtlas.R1}" SourceRect="1331,0,443,444" />
            <CroppedBitmap x:Key="Tcc.Strata.MentalStateGlyph.Stressed"
                           Source="{StaticResource Tcc.Strata.MentalStateAtlas.R1}" SourceRect="0,444,444,443" />
            <CroppedBitmap x:Key="Tcc.Strata.MentalStateGlyph.Fatigued"
                           Source="{StaticResource Tcc.Strata.MentalStateAtlas.R1}" SourceRect="444,444,443,443" />
            <CroppedBitmap x:Key="Tcc.Strata.MentalStateGlyph.Impulsive"
                           Source="{StaticResource Tcc.Strata.MentalStateAtlas.R1}" SourceRect="887,444,444,443" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource Tcc.Strata.Brush.Background}">
        <ScrollViewer x:Name="MainContentScroller"
                       AutomationProperties.AutomationId="MainContentScroller"
                       AutomationProperties.Name="Strata Observatory HOME"
                       AutomationProperties.HelpText="At constrained window sizes or enlarged text, use the scroll bars or arrow keys to explore the full HOME composition."
                       AutomationProperties.LiveSetting="Polite"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Left"
                      VerticalContentAlignment="Top"
                      CanContentScroll="False"
                      PanningMode="Both"
                      Focusable="True"
                      IsTabStop="True"
                      FocusVisualStyle="{x:Null}">
                    <Canvas x:Name="ReferenceCompositionCanvas"
                            Width="1672" Height="941"
                            ClipToBounds="True"
                            Focusable="False">
                        <Image x:Name="MasterFidelitySceneImage"
                               Width="1672" Height="941"
                               Source="Assets/MasterFidelity/StrataObservatory.MasterR1.Scene.R26.png"
                               Stretch="UniformToFill"
                               Opacity="{DynamicResource Tcc.Strata.SceneOpacity}"
                               IsHitTestVisible="False" />

                        <Rectangle Width="1672" Height="941" Fill="{DynamicResource Tcc.Strata.Brush.SceneVeil}" IsHitTestVisible="False" />
                        <Rectangle Width="1320" Height="941" Fill="{DynamicResource Tcc.Strata.Brush.WorkspaceScrim}" IsHitTestVisible="False" />

                        <!-- Top chrome -->
                        <Border x:Name="TopChromeRegion" Canvas.Left="0" Canvas.Top="0" Width="1672" Height="52"
                                Background="{DynamicResource Tcc.Strata.Brush.Chrome}"
                                BorderBrush="{DynamicResource Tcc.Strata.Brush.Border}"
                                BorderThickness="0,0,0,1"
                                Panel.ZIndex="30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="604" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                                    <Border x:Name="TopChromeBrandMark" Width="36" Height="36" BorderBrush="{DynamicResource Tcc.Strata.Brush.Gold}" BorderThickness="1.1">
                                        <Control Width="14" Height="18"
                                                 Style="{StaticResource Strata.BrandMonogram}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="TRADING COMMAND" Style="{StaticResource Strata.ChromeBrandName}" />
                                        <TextBlock Margin="0,1,0,0" Text="STRATA OBSERVATORY" Style="{StaticResource Strata.ChromeBrandSubtitle}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="0" Width="1" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />

                                <TextBlock x:Name="TopChromeMotto" Grid.Column="1" Margin="28,0"
                                           Text="DISCIPLINE TRADES A LONGER TOMORROW"
                                           Style="{StaticResource Strata.ChromeMotto}"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Center" />

                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="304" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid x:Name="TopChromeOfflineStatus" Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Tcc.Strata.Brush.Danger}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="DATA OFFLINE" Style="{StaticResource Strata.ChromeStatusLabel}" />
                                            <TextBlock Text="READ ONLY" Style="{StaticResource Strata.ChromeStatusDetail}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="SearchUnavailableSurface" Grid.Column="1" Height="32" Margin="0,0,12,0"
                                            BorderBrush="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" BorderThickness="1"
                                            Background="{DynamicResource Tcc.Strata.Brush.SearchSurface}" VerticalAlignment="Center"
                                            IsHitTestVisible="False" Focusable="False"
                                            ToolTip="Search and command palette are unavailable in this offline presentation."
                                            AutomationProperties.Name="Search unavailable while data is offline"
                                            AutomationProperties.HelpText="Read-only presentation; search and command palette are unavailable.">
                                        <Grid Margin="10,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                                            <Control Grid.Column="0" Width="13" Height="13" Style="{StaticResource Strata.CommandGlyph.Search}" />
                                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Margin="7,0,0,0" Text="SEARCH UNAVAILABLE" Style="{StaticResource Strata.ChromeSearchLabel}" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Padding="4,1" BorderBrush="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="SearchKeyHint" Text="OFFLINE" Style="{StaticResource Strata.ChromeSearchState}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Width="1" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="WindowMinimizeButton" AutomationProperties.AutomationId="WindowMinimizeButton" AutomationProperties.Name="Minimize window" AutomationProperties.HelpText="Minimizes the application window." ToolTip="Minimize" Style="{StaticResource Strata.WindowButton}" Click="OnMinimizeWindowClick"><Control Width="14" Height="14" Style="{StaticResource Strata.WindowGlyph.Minimize}" /></Button>
                                        <Button x:Name="WindowMaximizeRestoreWindowButton" AutomationProperties.AutomationId="WindowMaximizeRestoreButton" AutomationProperties.Name="Maximize or restore window" AutomationProperties.HelpText="Maximizes the window or restores its previous size." ToolTip="Maximize or restore" Style="{StaticResource Strata.WindowButton}" Click="OnMaximizeRestoreWindowClick"><Control Width="14" Height="14" Style="{StaticResource Strata.WindowGlyph.Maximize}" /></Button>
                                        <Button x:Name="WindowCloseButton" AutomationProperties.AutomationId="WindowCloseButton" AutomationProperties.Name="Close window" AutomationProperties.HelpText="Closes the application window." ToolTip="Close" Style="{StaticResource Strata.WindowButton}" Click="OnCloseWindowClick"><Control Width="14" Height="14" Style="{StaticResource Strata.WindowGlyph.Close}" /></Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Left rail -->
                        <Border Canvas.Left="6" Canvas.Top="52" Width="98" Height="889"
                                Background="{DynamicResource Tcc.Strata.Brush.Nav}"
                                BorderBrush="{DynamicResource Tcc.Strata.Brush.Border}"
                                BorderThickness="1,0,1,0"
                                Panel.ZIndex="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="116" /><RowDefinition Height="91" /><RowDefinition Height="91" />
                                    <RowDefinition Height="91" /><RowDefinition Height="91" /><RowDefinition Height="91" />
                                    <RowDefinition Height="*" /><RowDefinition Height="88" /><RowDefinition Height="62" />
                                </Grid.RowDefinitions>

                                <Button x:Name="NavHome" Grid.Row="0" Height="116" AutomationProperties.AutomationId="NavHome" AutomationProperties.Name="Home selected, current page" AutomationProperties.ItemStatus="Current page" AutomationProperties.HelpText="Current page." ToolTip="Current page" Style="{StaticResource Strata.NavButton.Selected}" Click="OnHomeNavigationClick">
                                    <StackPanel>
                                        <Control Width="23" Height="23" Style="{StaticResource Strata.NavGlyph.Home}" />
                                        <TextBlock Margin="0,7,0,0" Text="HOME" Style="{StaticResource Strata.NavLabel.Selected}" Foreground="{Binding Foreground, ElementName=NavHome}" />
                                        <TextBlock x:Name="NavHomeCurrentState" Margin="0,3,0,0" Text="CURRENT" Style="{StaticResource Strata.NavState.Current}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavMarkets" Grid.Row="1" AutomationProperties.AutomationId="NavMarkets" AutomationProperties.Name="Market unavailable while offline" AutomationProperties.ItemStatus="Unavailable" AutomationProperties.HelpText="Unavailable while offline." ToolTip="Unavailable while offline" Style="{StaticResource Strata.NavButton}" IsEnabled="False">
                                    <StackPanel><Control Width="22" Height="22" Style="{StaticResource Strata.NavGlyph.Market}" /><TextBlock Margin="0,8,0,0" Text="MARKET" Style="{StaticResource Strata.NavLabel}" /></StackPanel>
                                </Button>
                                <Button x:Name="NavPlanning" Grid.Row="2" AutomationProperties.AutomationId="NavPlanning" AutomationProperties.Name="Open Plan" AutomationProperties.ItemStatus="Available" AutomationProperties.HelpText="Navigates to the read-only Plan page." ToolTip="Open Plan" Style="{StaticResource Strata.NavButton}" Click="OnPlanNavigationClick">
                                    <StackPanel><Control Width="22" Height="22" Style="{StaticResource Strata.NavGlyph.Plan}" /><TextBlock Margin="0,8,0,0" Text="PLAN" Style="{StaticResource Strata.NavLabel}" Foreground="{Binding Foreground, ElementName=NavPlanning}" /><TextBlock x:Name="NavPlanningCurrentState" Margin="0,3,0,0" Text="CURRENT" Style="{StaticResource Strata.NavState.Current}" Visibility="Collapsed" /></StackPanel>
                                </Button>
                                <Button x:Name="NavRisk" Grid.Row="3" AutomationProperties.AutomationId="NavRisk" AutomationProperties.Name="Risk unavailable while offline" AutomationProperties.ItemStatus="Unavailable" AutomationProperties.HelpText="Unavailable while offline." ToolTip="Unavailable while offline" Style="{StaticResource Strata.NavButton}" IsEnabled="False">
                                    <StackPanel><Control Width="22" Height="22" Style="{StaticResource Strata.NavGlyph.Risk}" /><TextBlock Margin="0,8,0,0" Text="RISK" Style="{StaticResource Strata.NavLabel}" /></StackPanel>
                                </Button>
                                <Button x:Name="NavPositions" Grid.Row="4" AutomationProperties.AutomationId="NavPositions" AutomationProperties.Name="Positions unavailable while offline" AutomationProperties.ItemStatus="Unavailable" AutomationProperties.HelpText="Unavailable while offline." ToolTip="Unavailable while offline" Style="{StaticResource Strata.NavButton}" IsEnabled="False">
                                    <StackPanel><Control Width="22" Height="22" Style="{StaticResource Strata.NavGlyph.Positions}" /><TextBlock Margin="0,8,0,0" Text="POSITIONS" Style="{StaticResource Strata.NavLabel}" /></StackPanel>
                                </Button>
                                <Button x:Name="NavReview" Grid.Row="5" AutomationProperties.AutomationId="NavReview" AutomationProperties.Name="Review unavailable" AutomationProperties.ItemStatus="Unavailable" AutomationProperties.HelpText="Not available in this presentation." ToolTip="Not available in this presentation" Style="{StaticResource Strata.NavButton}" IsEnabled="False">
                                    <StackPanel><Control Width="22" Height="22" Style="{StaticResource Strata.NavGlyph.Review}" /><TextBlock Margin="0,8,0,0" Text="REVIEW" Style="{StaticResource Strata.NavLabel}" /></StackPanel>
                                </Button>
                                <Border Grid.Row="6" Margin="20,0" BorderBrush="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" BorderThickness="0,0,0,1" />
                                <Button x:Name="NavSettings" Grid.Row="7" AutomationProperties.AutomationId="NavSettings" AutomationProperties.Name="Settings unavailable" AutomationProperties.ItemStatus="Unavailable" AutomationProperties.HelpText="Not available in this presentation." ToolTip="Not available in this presentation" Style="{StaticResource Strata.NavButton}" IsEnabled="False">
                                    <StackPanel><Control Width="22" Height="22" Style="{StaticResource Strata.NavGlyph.Settings}" /><TextBlock Margin="0,8,0,0" Text="SETTINGS" Style="{StaticResource Strata.NavLabel}" /></StackPanel>
                                </Button>
                                <StackPanel Grid.Row="8" Margin="17,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="v1.0" Style="{StaticResource Strata.RailFooter}" />
                                    <TextBlock Margin="0,3,0,0" Text="STRATA&#x0a;OBSERVATORY" Style="{StaticResource Strata.RailFooter}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Canvas x:Name="HomePageLayer" Width="1672" Height="941">
                        <!-- Header field -->
                        <Border Canvas.Left="104" Canvas.Top="52" Width="1154" Height="186" Background="{DynamicResource Tcc.Strata.Brush.HeaderField}" BorderBrush="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid x:Name="HeaderIdentityRegion" Width="452" Height="101" Margin="44,70,0,0"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      IsHitTestVisible="False" Focusable="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="17" />
                                        <RowDefinition Height="46" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="1" Background="{DynamicResource Tcc.Strata.Brush.Gold}" />
                                        <TextBlock Margin="8,0,0,0" Text="HOME / OBSERVATORY" Style="{StaticResource Strata.HeaderEyebrow}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="16,-1,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeaderIdentityLabel" Text="Market Observatory"
                                                   Style="{StaticResource Strata.HeaderTitle}"
                                                   AutomationProperties.AutomationId="Region.HeaderIdentity"
                                                   AutomationProperties.Name="Market Observatory"
                                                   AutomationProperties.HelpText="Home workspace. Read the terrain, manage risk, and execute with discipline." />
                                        <Control x:Name="HeaderIdentitySeal" Margin="12,1,0,0" Width="18" Height="28"
                                                 Style="{StaticResource Strata.Seal.Vertical}"
                                                 VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="16,1,0,0" Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBlock Text="READ THE TERRAIN" Style="{StaticResource Strata.HeaderPrinciple}" />
                                        <Border Width="1" Height="10" Margin="11,0" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                        <TextBlock Text="MANAGE RISK" Style="{StaticResource Strata.HeaderPrinciple}" />
                                        <Border Width="1" Height="10" Margin="11,0" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                        <TextBlock Text="EXECUTE WITH DISCIPLINE" Style="{StaticResource Strata.HeaderPrinciple}" />
                                    </StackPanel>
                                    <Border Grid.RowSpan="3" Width="1" Height="65" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                </Grid>

                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,6,0" Width="640" Height="101"
                                        Style="{StaticResource Strata.Panel.Safety}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="150" /><ColumnDefinition Width="154" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="4" Height="1" Margin="1,1,1,0" Background="{DynamicResource Tcc.Strata.Brush.EdgeGlint}" VerticalAlignment="Top" Panel.ZIndex="2" IsHitTestVisible="False" />
                                        <Border x:Name="TradingPermissionCell" Grid.Column="0" Margin="0,12" Padding="16,0,17,0" BorderBrush="{DynamicResource Tcc.Strata.Brush.Border}" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Width="2" Height="44" Background="{DynamicResource Tcc.Strata.Brush.Danger}" VerticalAlignment="Center" />
                                                <Grid Grid.Column="1" Margin="12,0,0,0">
                                                    <Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="27" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                                                    <TextBlock x:Name="SafetyRegionLabel" Text="Trading Permission" Style="{StaticResource Strata.SafetyLabel.Primary}" AutomationProperties.AutomationId="Region.HomeSafetyCore" AutomationProperties.Name="Home safety core, offline and unknown" />
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="TradingPermissionMarker" Width="13" Height="13" Stroke="{DynamicResource Tcc.Strata.Brush.Danger}" StrokeThickness="2" />
                                                        <TextBlock x:Name="TradingPermissionValue" Margin="8,-2,0,0" Text="OFFLINE" Style="{StaticResource Strata.StatusValue}" Foreground="{DynamicResource Tcc.Strata.Brush.Danger}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="TradingPermissionHelper" Grid.Row="2" Text="Read only · Not tradable" Style="{StaticResource Strata.Caption}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="TotalRiskCell" Grid.Column="1" Margin="0,12" Padding="18,0,13,0" BorderBrush="{DynamicResource Tcc.Strata.Brush.Border}" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="27" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                                                <TextBlock Text="Total Risk" Style="{StaticResource Strata.SafetyLabel}" />
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><Control x:Name="TotalRiskUnsetMarker" Width="7" Height="7" Style="{StaticResource Strata.UnsetStatusMarker}" /><TextBlock x:Name="TotalRiskValue" Margin="7,-3,0,0" Text="UNKNOWN" Style="{StaticResource Strata.StatusUnknown}" /></StackPanel>
                                                <TextBlock x:Name="TotalRiskHelper" Grid.Row="2" Text="No live data" Style="{StaticResource Strata.Caption}" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="PositionsCell" Grid.Column="2" Margin="0,12" Padding="18,0,13,0" BorderBrush="{DynamicResource Tcc.Strata.Brush.Border}" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="27" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                                                <TextBlock Text="Current Positions" Style="{StaticResource Strata.SafetyLabel}" />
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><Control x:Name="PositionsUnsetMarker" Width="7" Height="7" Style="{StaticResource Strata.UnsetStatusMarker}" /><TextBlock x:Name="PositionsValue" Margin="7,-3,0,0" Text="UNKNOWN" Style="{StaticResource Strata.StatusUnknown}" /></StackPanel>
                                                <TextBlock x:Name="PositionsHelper" Grid.Row="2" Text="Awaiting sync" Style="{StaticResource Strata.Caption}" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="AlertsCell" Grid.Column="3" Margin="0,12" Padding="18,0,13,0">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="27" /><RowDefinition Height="18" /></Grid.RowDefinitions>
                                                <TextBlock Text="Major Alerts" Style="{StaticResource Strata.SafetyLabel}" />
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><Control x:Name="AlertsUnsetMarker" Width="7" Height="7" Style="{StaticResource Strata.UnsetStatusMarker}" /><TextBlock x:Name="AlertsValue" Margin="7,-3,0,0" Text="UNKNOWN" Style="{StaticResource Strata.StatusUnknown}" /></StackPanel>
                                                <TextBlock x:Name="AlertsHelper" Grid.Row="2" Text="Cannot evaluate" Style="{StaticResource Strata.Caption}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Market overview -->
                        <Border Canvas.Left="126" Canvas.Top="239" Width="870" Height="404"
                                Style="{StaticResource Strata.Panel.Primary}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>
                                <Border Grid.RowSpan="4" Height="1" Margin="1,1,1,0" Background="{DynamicResource Tcc.Strata.Brush.EdgeGlint}" VerticalAlignment="Top" Panel.ZIndex="2" IsHitTestVisible="False" />
                                <Control Grid.RowSpan="4" Margin="1" Style="{StaticResource Strata.CraftFrame}" Panel.ZIndex="3" />
                                <Grid Margin="31,0,24,0" Panel.ZIndex="5">
                                    <TextBlock Text="Market Overview" Style="{StaticResource Strata.SectionTitle}"
                                               AutomationProperties.AutomationId="Region.MarketOverview" AutomationProperties.Name="Market overview, offline"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Width="28" Height="1" Margin="0,0,10,0" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                        <TextBlock Text="READ-ONLY ANALYSIS" Style="{StaticResource Strata.Overline}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="31,0,24,4" Panel.ZIndex="5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Width="48" Text="SYMBOL" Style="{StaticResource Strata.Overline}" VerticalAlignment="Center" />
                                        <Button AutomationProperties.AutomationId="TabBtcUsdt" AutomationProperties.Name="BTC USDT selected, unavailable offline" Content="BTC / USDT" Style="{StaticResource Strata.MarketTabButton.Selected}" IsEnabled="False" />
                                        <Button AutomationProperties.AutomationId="TabEthUsdt" AutomationProperties.Name="ETH USDT unavailable offline" Content="ETH / USDT" Style="{StaticResource Strata.MarketTabButton}" IsEnabled="False" />
                                        <Button AutomationProperties.AutomationId="TabSolUsdt" AutomationProperties.Name="SOL USDT unavailable offline" Content="SOL / USDT" Style="{StaticResource Strata.MarketTabButton}" IsEnabled="False" />
                                        <Button AutomationProperties.AutomationId="TabBnbUsdt" AutomationProperties.Name="BNB USDT unavailable offline" Content="BNB / USDT" Style="{StaticResource Strata.MarketTabButton}" IsEnabled="False" />
                                        <Button AutomationProperties.AutomationId="TabXrpUsdt" AutomationProperties.Name="XRP USDT unavailable offline" Content="XRP / USDT" Style="{StaticResource Strata.MarketTabButton}" IsEnabled="False" />
                                        <Button AutomationProperties.AutomationId="TabAddSymbol" AutomationProperties.Name="Add symbol unavailable offline" Width="36" Style="{StaticResource Strata.MarketTabButton}" IsEnabled="False"><Control Width="13" Height="13" Style="{StaticResource Strata.CommandGlyph.Add}" /></Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Width="43" Text="RANGE" Style="{StaticResource Strata.Overline}" VerticalAlignment="Center" />
                                        <Button AutomationProperties.AutomationId="Timeframe1H" AutomationProperties.Name="1 hour timeframe unavailable offline" Content="1H" Style="{StaticResource Strata.MarketTabButton}" IsEnabled="False" />
                                        <Button AutomationProperties.AutomationId="Timeframe4H" AutomationProperties.Name="4 hour timeframe unavailable offline" Content="4H" Style="{StaticResource Strata.MarketTabButton}" IsEnabled="False" />
                                        <Button AutomationProperties.AutomationId="Timeframe1D" AutomationProperties.Name="1 day timeframe selected, unavailable offline" Content="1D" Style="{StaticResource Strata.MarketTabButton.Selected}" IsEnabled="False" />
                                        <Button AutomationProperties.AutomationId="Timeframe1W" AutomationProperties.Name="1 week timeframe unavailable offline" Content="1W" Style="{StaticResource Strata.MarketTabButton}" IsEnabled="False" />
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="OfflineMarketBody" Grid.Row="2" Margin="31,0,24,0" Background="{DynamicResource Tcc.Strata.Brush.ChartInset}" Panel.ZIndex="5">
                                    <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid Margin="20,0,18,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Tcc.Strata.Brush.Danger}" />
