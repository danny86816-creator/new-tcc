<UserControl x:Class="Tcc.DesktopHost.PlanDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="1568" MinHeight="889"
             Background="{DynamicResource Tcc.Strata.Brush.Background}"
             Foreground="{DynamicResource Tcc.Strata.Brush.Text}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="Plan.Surface.Primary" TargetType="Border" BasedOn="{StaticResource Strata.Panel.Primary}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tcc.Strata.Brush.Border}" />
        </Style>
        <Style x:Key="Plan.Surface.Secondary" TargetType="Border" BasedOn="{StaticResource Strata.Panel.Secondary}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
        </Style>
        <Style x:Key="Plan.Surface.Step" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Tcc.Strata.Brush.PanelQuiet}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tcc.Strata.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="Plan.Surface.Action" TargetType="Border" BasedOn="{StaticResource Strata.Panel.Primary}">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tcc.Strata.Brush.BorderBright}" />
        </Style>
        <Style x:Key="Plan.ViewportFocusVisual" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Border Margin="2" BorderBrush="{DynamicResource Tcc.Strata.Brush.Ice}" BorderThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Tcc.Strata.Brush.Background}">
        <Image Source="Assets/Plan/Tcc.PlanDashboard.HomeStyle.Background.R1.png"
               Stretch="UniformToFill"
               Opacity="{DynamicResource Tcc.Strata.SceneOpacity}"
               RenderOptions.BitmapScalingMode="HighQuality"
               IsHitTestVisible="False"
               Focusable="False" />
        <Rectangle Fill="{DynamicResource Tcc.Strata.Brush.SceneVeil}" IsHitTestVisible="False" />

        <ScrollViewer x:Name="PlanDashboardScroller"
                      AutomationProperties.AutomationId="PlanDashboardScroller"
                      AutomationProperties.Name="交易計畫儀表板唯讀展示"
                      AutomationProperties.HelpText="唯讀交易計畫儀表板。文字放大時，請在此計畫面板按 PageDown。視窗較小時，按 Tab 移至外層頁面捲動區，再按 PageDown 前往計畫下方區域；可用向左鍵或向右鍵檢視完整寬度。"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      PanningMode="Both"
                      Focusable="True"
                      IsTabStop="True"
                      FocusVisualStyle="{StaticResource Plan.ViewportFocusVisual}">
            <Grid MinWidth="1476" MinHeight="817" Margin="34,24,38,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="計畫 / 工作台" Style="{StaticResource Strata.HeaderEyebrow}"
                                   AutomationProperties.AutomationId="Plan.Header"
                                   AutomationProperties.Name="交易計畫工作台，唯讀展示" />
                        <TextBlock Margin="0,4,0,0" Text="交易計畫" Style="{StaticResource Strata.PageTitle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="離線 · 唯讀" Style="{StaticResource Strata.StatusValue}"
                                   Foreground="{DynamicResource Tcc.Strata.Brush.Danger}"
                                   HorizontalAlignment="Right"
                                   AutomationProperties.AutomationId="Plan.GlobalState"
                                   AutomationProperties.Name="離線。計畫資料無法使用，系統不推測任何紀錄。"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Margin="0,4,0,0" Text="無即時資料" Style="{StaticResource Strata.Overline}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,16,0,16" Padding="18,13"
                        Style="{StaticResource Plan.Surface.Primary}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.55*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="3" Height="38" Margin="0,0,14,0" Background="{DynamicResource Tcc.Strata.Brush.Gold}" />
                            <StackPanel>
                                <TextBlock Text="首頁安全核心" Style="{StaticResource Strata.SectionTitle}"
                                           AutomationProperties.AutomationId="Plan.SafetyCore"
                                           AutomationProperties.Name="首頁安全核心。交易權限離線；總風險、持倉與重大警示目前無法使用。" />
                                <TextBlock Margin="0,3,0,0" Text="安全語意固定不變" Style="{StaticResource Strata.Caption}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Padding="18,0" BorderBrush="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" BorderThickness="1,0,0,0">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="交易權限" Style="{StaticResource Strata.Overline}" /><TextBlock Margin="0,5,0,0" Text="●  離線" Style="{StaticResource Strata.StatusValue}" Foreground="{DynamicResource Tcc.Strata.Brush.Danger}" /></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="18,0" BorderBrush="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" BorderThickness="1,0,0,0">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="總風險" Style="{StaticResource Strata.Overline}" /><TextBlock Margin="0,5,0,0" Text="◇  未知" Style="{StaticResource Strata.StatusUnknown}" /></StackPanel>
                        </Border>
                        <Border Grid.Column="3" Padding="18,0" BorderBrush="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" BorderThickness="1,0,0,0">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="持倉 / 警示" Style="{StaticResource Strata.Overline}" /><TextBlock Margin="0,5,0,0" Text="◇  未知" Style="{StaticResource Strata.StatusUnknown}" /></StackPanel>
                        </Border>
                        <Border Grid.Column="4" Padding="18,0" BorderBrush="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" BorderThickness="1,0,0,0">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="GPT 可選 · 非正式評分" Style="{StaticResource Strata.Overline}" /><TextBlock Margin="0,5,0,0" Text="未使用" Style="{StaticResource Strata.StatusUnknown}" /></StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="22,18" Style="{StaticResource Plan.Surface.Primary}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="30" Margin="0,0,14,0" Background="{DynamicResource Tcc.Strata.Brush.Gold}" />
                                    <StackPanel>
                                        <TextBlock Text="計畫工作台" Style="{StaticResource Strata.SectionTitle}"
                                                   AutomationProperties.AutomationId="Plan.Drafts"
                                                   AutomationProperties.Name="計畫工作台。草稿計畫與正式快照維持明確區隔。" />
                                        <TextBlock Margin="0,3,0,0" Text="正式化前請先檢視 · 本階段不提供操作" Style="{StaticResource Strata.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" MinWidth="132" Content="＋  新增計畫" Style="{StaticResource Strata.Button}"
                                        IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="建立計畫不在本唯讀展示階段範圍內。"
                                        AutomationProperties.AutomationId="Plan.NewPlan" AutomationProperties.Name="新增計畫目前無法使用"
                                        AutomationProperties.HelpText="本唯讀展示階段尚未實作建立計畫功能。" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Content="草稿" Height="48" MinHeight="44" Style="{StaticResource Strata.TabButton.Selected}"
                                        IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="目前選取草稿檢視；切換功能尚未提供。"
                                        AutomationProperties.AutomationId="Plan.Filter.All" AutomationProperties.Name="已選取草稿檢視，目前無法切換" />
                                <Button Grid.Column="1" Content="正式快照" Height="48" MinHeight="44" Style="{StaticResource Strata.TabButton}"
                                        IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="本唯讀展示階段尚未提供正式快照。"
                                        AutomationProperties.AutomationId="Plan.Filter.Formal" AutomationProperties.Name="正式快照目前無法使用" />
                                <Button Visibility="Collapsed" IsEnabled="False" Content="草稿"
                                        AutomationProperties.AutomationId="Plan.Filter.Drafts" AutomationProperties.Name="草稿篩選目前無法使用" />
                            </Grid>

                            <GroupBox x:Name="PlanStateRegion" Grid.Row="2" Margin="0,14,0,0"
                                      BorderThickness="0" Padding="0" Background="Transparent"
                                      Focusable="False" IsTabStop="False"
                                      AutomationProperties.AutomationId="Plan.StateRegion"
                                      AutomationProperties.Name="離線。計畫資料無法使用，系統不推測任何計畫。"
                                      AutomationProperties.LiveSetting="Polite">
                                <GroupBox.Template><ControlTemplate TargetType="GroupBox"><ContentPresenter /></ControlTemplate></GroupBox.Template>
                                <Grid MinHeight="74">
                                    <Border x:Name="EmptyState" Visibility="Collapsed" Padding="16,12" Style="{StaticResource Plan.Surface.Secondary}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="空白" Style="{StaticResource Strata.StatusValue}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="尚無草稿計畫" Style="{StaticResource Strata.EmptyStateTitle}" /><TextBlock Margin="0,4,0,0" Text="建立計畫功能不在本唯讀展示階段範圍內。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel></Grid>
                                    </Border>
                                    <Border x:Name="LoadingState" Visibility="Collapsed" Padding="16,12" Style="{StaticResource Plan.Surface.Secondary}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="載入中" Style="{StaticResource Strata.StatusValue}" /><ProgressBar Margin="0,8,0,0" Height="5" IsIndeterminate="True" IsHitTestVisible="False" /></StackPanel><TextBlock Grid.Column="1" Margin="18,0,0,0" Text="載入期間，草稿與正式紀錄仍維持區隔。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
                                    </Border>
                                    <Border x:Name="OfflineState" Padding="16,12" BorderBrush="{DynamicResource Tcc.Strata.Brush.Danger}" BorderThickness="2,0,0,0" Background="{DynamicResource Tcc.Strata.Brush.PanelQuiet}" CornerRadius="2">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="離線 · 唯讀" Style="{StaticResource Strata.StatusValue}" Foreground="{DynamicResource Tcc.Strata.Brush.Danger}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="計畫資料無法使用" Style="{StaticResource Strata.EmptyStateTitle}" /><TextBlock Margin="0,4,0,0" Text="系統不宣稱存在快取紀錄。請重新連線，或在另行授權的復原流程可用時使用該流程。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel></Grid>
                                    </Border>
                                    <Border x:Name="ErrorState" Visibility="Collapsed" Padding="16,12" BorderBrush="{DynamicResource Tcc.Strata.Brush.Danger}" BorderThickness="2,0,0,0" Background="{DynamicResource Tcc.Strata.Brush.PanelQuiet}" CornerRadius="2">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="錯誤" Style="{StaticResource Strata.StatusValue}" Foreground="{DynamicResource Tcc.Strata.Brush.Danger}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="無法讀取計畫索引" Style="{StaticResource Strata.EmptyStateTitle}" /><TextBlock Margin="0,4,0,0" Text="資料未被變更。本階段尚未實作重試與復原中心功能。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel></Grid>
                                    </Border>
                                    <Border x:Name="BlockedState" Visibility="Collapsed" Padding="16,12" BorderBrush="{DynamicResource Tcc.Strata.Brush.Gold}" BorderThickness="2,0,0,0" Background="{DynamicResource Tcc.Strata.Brush.PanelQuiet}" CornerRadius="2">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="已阻擋" Style="{StaticResource Strata.StatusValue}" Foreground="{DynamicResource Tcc.Strata.Brush.Gold}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="計畫存取已被阻擋" Style="{StaticResource Strata.EmptyStateTitle}" /><TextBlock Margin="0,4,0,0" Text="權限與風險原因必須保持可見；本階段不提供略過方式。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" /></StackPanel></Grid>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <Grid Grid.Row="3" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Plan.Surface.Step}"><StackPanel VerticalAlignment="Center"><TextBlock Text="01" Style="{StaticResource Strata.StatusUnknown}" HorizontalAlignment="Center" /><TextBlock Margin="0,9,0,0" Text="目前" Style="{StaticResource Strata.SectionTitle}" HorizontalAlignment="Center" /><Border Margin="8,10" Height="1" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" /><TextBlock Text="未知" Style="{StaticResource Strata.StatusUnknown}" HorizontalAlignment="Center" /><TextBlock Margin="0,5,0,0" Text="—" Style="{StaticResource Strata.Numeric}" HorizontalAlignment="Center" /></StackPanel></Border>
                                <TextBlock Grid.Column="1" Text="→" Style="{StaticResource Strata.SectionTitle}" Foreground="{DynamicResource Tcc.Strata.Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource Plan.Surface.Step}" BorderBrush="{DynamicResource Tcc.Strata.Brush.Gold}"><StackPanel VerticalAlignment="Center"><TextBlock Text="02" Style="{StaticResource Strata.StatusUnknown}" Foreground="{DynamicResource Tcc.Strata.Brush.Gold}" HorizontalAlignment="Center" /><TextBlock Margin="0,9,0,0" Text="建議" Style="{StaticResource Strata.SectionTitle}" HorizontalAlignment="Center" /><Border Margin="8,10" Height="1" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" /><TextBlock Text="未知" Style="{StaticResource Strata.StatusUnknown}" HorizontalAlignment="Center" /><TextBlock Margin="0,5,0,0" Text="—" Style="{StaticResource Strata.Numeric}" HorizontalAlignment="Center" /></StackPanel></Border>
                                <TextBlock Grid.Column="3" Text="→" Style="{StaticResource Strata.SectionTitle}" Foreground="{DynamicResource Tcc.Strata.Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Grid.Column="4" Style="{StaticResource Plan.Surface.Step}"><StackPanel VerticalAlignment="Center"><TextBlock Text="03" Style="{StaticResource Strata.StatusUnknown}" HorizontalAlignment="Center" /><TextBlock Margin="0,9,0,0" Text="風險影響" Style="{StaticResource Strata.SectionTitle}" HorizontalAlignment="Center" /><Border Margin="8,10" Height="1" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" /><TextBlock Text="未知" Style="{StaticResource Strata.StatusUnknown}" HorizontalAlignment="Center" /><TextBlock Margin="0,5,0,0" Text="—" Style="{StaticResource Strata.Numeric}" HorizontalAlignment="Center" /></StackPanel></Border>
                                <TextBlock Grid.Column="5" Text="→" Style="{StaticResource Strata.SectionTitle}" Foreground="{DynamicResource Tcc.Strata.Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Grid.Column="6" Style="{StaticResource Plan.Surface.Step}"><StackPanel VerticalAlignment="Center"><TextBlock Text="04" Style="{StaticResource Strata.StatusUnknown}" HorizontalAlignment="Center" /><TextBlock Margin="0,9,0,0" Text="確認" Style="{StaticResource Strata.SectionTitle}" HorizontalAlignment="Center" /><Border Margin="8,10" Height="1" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" /><TextBlock Text="無法使用" Style="{StaticResource Strata.StatusUnknown}" HorizontalAlignment="Center" /><TextBlock Margin="0,5,0,0" Text="—" Style="{StaticResource Strata.Numeric}" HorizontalAlignment="Center" /></StackPanel></Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="1.25*" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="20,17" Style="{StaticResource Plan.Surface.Primary}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><Border Width="3" Height="27" Margin="0,0,14,0" Background="{DynamicResource Tcc.Strata.Brush.Gold}" /><TextBlock Text="安全檢視" Style="{StaticResource Strata.SectionTitle}" /></StackPanel>
                                <TextBlock Margin="0,5,0,12" Text="產品服務就緒前，本區維持唯讀。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" AutomationProperties.AutomationId="Plan.SafetyReview" AutomationProperties.Name="安全檢視。系統狀態、市場資料、帳戶資料、執行服務與 AI 助理目前無法使用。" />
                                <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="系統狀態" Style="{StaticResource Strata.Body}" /><TextBlock Grid.Column="1" Text="無法使用" Style="{StaticResource Strata.StatusUnknown}" /></Grid><Border Height="1" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="市場資料" Style="{StaticResource Strata.Body}" /><TextBlock Grid.Column="1" Text="無法使用" Style="{StaticResource Strata.StatusUnknown}" /></Grid><Border Height="1" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="帳戶資料" Style="{StaticResource Strata.Body}" /><TextBlock Grid.Column="1" Text="無法使用" Style="{StaticResource Strata.StatusUnknown}" /></Grid><Border Height="1" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="執行服務" Style="{StaticResource Strata.Body}" /><TextBlock Grid.Column="1" Text="無法使用" Style="{StaticResource Strata.StatusUnknown}" /></Grid><Border Height="1" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="AI 助理" Style="{StaticResource Strata.Body}" /><TextBlock Grid.Column="1" Text="可選 · 非正式評分" Style="{StaticResource Strata.StatusUnknown}" /></Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Padding="20,17" Style="{StaticResource Plan.Surface.Secondary}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><Border Width="3" Height="27" Margin="0,0,14,0" Background="{DynamicResource Tcc.Strata.Brush.Gold}" /><TextBlock Text="資料來源 / 更新狀態" Style="{StaticResource Strata.SectionTitle}" /></StackPanel>
                                <TextBlock Margin="0,5,0,12" Text="所有缺漏輸入均明確標示。" Style="{StaticResource Strata.Caption}" AutomationProperties.AutomationId="Plan.SourceTruth" AutomationProperties.Name="資料來源與更新狀態。目前沒有即時市場、參考、新聞或研究來源；GPT 未使用。" />
                                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="市場資料來源" Style="{StaticResource Strata.Body}" /><TextBlock Grid.Column="1" Text="未知" Style="{StaticResource Strata.StatusUnknown}" /></Grid><Border Height="1" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="參考資料來源" Style="{StaticResource Strata.Body}" /><TextBlock Grid.Column="1" Text="未知" Style="{StaticResource Strata.StatusUnknown}" /></Grid><Border Height="1" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="新聞 / 研究來源" Style="{StaticResource Strata.Body}" /><TextBlock Grid.Column="1" Text="未知" Style="{StaticResource Strata.StatusUnknown}" /></Grid><Border Height="1" Background="{DynamicResource Tcc.Strata.Brush.BorderQuiet}" />
                                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="最後更新" Style="{StaticResource Strata.Body}" /><TextBlock Grid.Column="1" Text="未知" Style="{StaticResource Strata.StatusUnknown}" /></Grid>
                                <TextBlock Margin="0,10,0,0" Text="連接器 · 僅限唯讀範圍" Style="{StaticResource Strata.Caption}" />
                                <TextBlock Margin="0,4,0,0" Text="GPT · 可選 · 未使用 · 非正式評分" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Text="衝突仍須手動處理；目前沒有下單或執行路徑。" Style="{StaticResource Strata.Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Margin="274,16,0,0" MinHeight="68" Padding="20,12" Style="{StaticResource Plan.Surface.Action}" AutomationProperties.Name="下一步。正式化前請先檢視風險；本唯讀展示階段不提供操作。" Focusable="False" IsHitTestVisible="False">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="1" Margin="0,0,16,0" Background="{DynamicResource Tcc.Strata.Brush.Gold}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="下一步" Style="{StaticResource Strata.SectionTitle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Margin="26,0,0,0" Text="正式化前請先檢視風險 · 本階段無法執行" Style="{StaticResource Strata.DisplayBody}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="→" Foreground="{DynamicResource Tcc.Strata.Brush.Gold}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="草稿 ≠ 正式 · 操作前先確認安全" Style="{StaticResource Strata.FooterMotto}" />
