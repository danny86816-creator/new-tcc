<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Style x:Key="Tcc.ReferenceMaster.FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderBrush="{DynamicResource Tcc.ReferenceMaster.Brush.Border.Selected}" BorderThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tcc.ReferenceMaster.NavigationItem" TargetType="Button">
        <Setter Property="Height" Value="52" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tcc.ReferenceMaster.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Data="{TemplateBinding Tag}" Style="{DynamicResource Tcc.ReferenceMaster.Icon.Utility}"
                                  Stroke="{TemplateBinding Foreground}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{DynamicResource Tcc.ReferenceMaster.Text.Body}"
                                       Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Text.Disabled}" />
                            <Setter Property="Opacity" Value="0.94" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Tcc.ReferenceMaster.NavigationItem.Selected" TargetType="Button" BasedOn="{StaticResource Tcc.ReferenceMaster.NavigationItem}">
        <Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.Selected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Border.Selected}" />
        <Setter Property="Foreground" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Accent.Ice}" />
    </Style>

    <Style x:Key="Tcc.ReferenceMaster.ChromeButton" TargetType="Button">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Foreground" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Text.Secondary}" />
        <Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.PanelDeep}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Border.Quiet}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tcc.ReferenceMaster.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.Hover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.Pressed}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.68" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Tcc.ReferenceMaster.PrimaryCta" TargetType="Button" BasedOn="{StaticResource Tcc.ReferenceMaster.ChromeButton}">
        <Setter Property="Foreground" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Text.OnAction}" />
        <Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.Action}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Border.Action}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border Margin="2" BorderBrush="{DynamicResource Tcc.ReferenceMaster.Brush.Border.ActionInner}"
                                    BorderThickness="1,1,0,0" />
                            <Border Height="1" Margin="10,3,10,0" VerticalAlignment="Top"
                                    Background="{DynamicResource Tcc.ReferenceMaster.Brush.Accent.Ice}" Opacity="0.72" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.Hover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.Pressed}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.94" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Tcc.ReferenceMaster.WindowCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Border.Quiet}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tcc.ReferenceMaster.FocusVisual}" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.Hover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.Pressed}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tcc.ReferenceMaster.WindowMaximizeButton" TargetType="Button" BasedOn="{StaticResource Tcc.ReferenceMaster.WindowCaptionButton}">
        <Setter Property="Content" Value="□" />
        <Setter Property="AutomationProperties.Name" Value="Maximize window" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="Content" Value="❐" />
                <Setter Property="AutomationProperties.Name" Value="Restore window" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Tcc.ReferenceMaster.SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Text.Secondary}" />
        <Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.PanelDeep}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Border.Quiet}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Tcc.ReferenceMaster.FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Tcc.ReferenceMaster.FontSize.Body}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Tcc.ReferenceMaster.FocusVisual}" />
    </Style>
    <Style x:Key="Tcc.ReferenceMaster.Badge.Status" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.PanelDeep}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Border.Quiet}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Padding" Value="5,1" />
    </Style>
    <Style x:Key="Tcc.ReferenceMaster.IdentityPlaque" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.Auxiliary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Border.Frost}" />
        <Setter Property="BorderThickness" Value="1,0,1,0" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style x:Key="Tcc.ReferenceMaster.AiSummaryInner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Surface.Scene.DenseInterior}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Border.Auxiliary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Padding" Value="8,5" />
    </Style>
</ResourceDictionary>
