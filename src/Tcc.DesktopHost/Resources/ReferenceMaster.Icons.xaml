    <Style x:Key="Tcc.ReferenceMaster.Icon.Base" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Text.Secondary}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Tcc.ReferenceMaster.Icon.Utility" TargetType="Path" BasedOn="{StaticResource Tcc.ReferenceMaster.Icon.Base}">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
    </Style>
    <Style x:Key="Tcc.ReferenceMaster.Icon.Module" TargetType="Path" BasedOn="{StaticResource Tcc.ReferenceMaster.Icon.Base}">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Stroke" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Accent.Ice}" />
    </Style>
    <Style x:Key="Tcc.ReferenceMaster.Icon.Safety" TargetType="Path" BasedOn="{StaticResource Tcc.ReferenceMaster.Icon.Base}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="StrokeThickness" Value="2.2" />
    </Style>
    <Style x:Key="Tcc.ReferenceMaster.Icon.Meditation" TargetType="Path" BasedOn="{StaticResource Tcc.ReferenceMaster.Icon.Base}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Fill" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Accent.Ice}" />
        <Setter Property="Stroke" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Text.Secondary}" />
        <Setter Property="StrokeThickness" Value="0.65" />
        <Setter Property="Opacity" Value="0.82" />
    </Style>
    <Style x:Key="Tcc.ReferenceMaster.Icon.EmptyState" TargetType="Path" BasedOn="{StaticResource Tcc.ReferenceMaster.Icon.Base}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Stroke" Value="{DynamicResource Tcc.ReferenceMaster.Brush.Status.Unavailable}" />
    </Style>
</ResourceDictionary>
